{
  "name": "pi-lm-studio-provider",
  "version": "0.1.2",
  "description": "Register local LM Studio models as a Pi provider after discovering LM Studio's local API.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "lm-studio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patlux/pi-lm-studio-provider.git"
  },
  "homepage": "https://github.com/patlux/pi-lm-studio-provider#readme",
  "bugs": {
    "url": "https://github.com/patlux/pi-lm-studio-provider/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
